{
  "name": "az-vuelos",
  "private": true,
  "version": "0.1.0",
  "description": "AZ Vuelos — precios reales leídos del sitio oficial de cada aerolínea, con evidencia.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "catalogos": "tsx scripts/descargar-catalogos.ts",
    "eventos": "tsx scripts/actualizar-eventos.ts",
    "tendencia": "tsx scripts/tendencias.ts",
    "corroborar": "tsx scripts/corroborar-wikipedia.ts",
    "precios": "tsx scripts/precios-travelpayouts.ts"
  },
  "dependencies": {
    "@az/core": "workspace:*",
    "@az/espacio": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
